# Copy these into the Vercel project: Settings → Environment Variables.
# They are required at build time. Do not commit real keys.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key. Safe in the browser. Row Level Security still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Service role key. Server only. Used to create team logins and to store website inquiries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated browser origins allowed to POST /api/inquiries. No trailing slash.
# Localhost is always allowed. Example: https://yesser.example,https://yesser-barka.workers.dev
CONTACT_SITE_ORIGINS=
